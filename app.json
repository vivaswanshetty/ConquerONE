{
  "expo": {
    "name": "ConquerONE",
    "slug": "conquer-one",
    "scheme": "conquerone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.conquerone.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "CONQUER ONE needs access to your health data to sync your workouts and track progress across devices.",
        "NSHealthUpdateUsageDescription": "CONQUER ONE will archive your workout sessions in Apple Health for a unified performance overview."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.conquerone.app",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_BASAL_METABOLIC_RATE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.WRITE_ACTIVE_CALORIES_BURNED",
        "android.permission.health.WRITE_TOTAL_CALORIES_BURNED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C8202A",
          "sounds": []
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "react-native-health-connect",
        {
          "healthPermissionRead": [
            "ActiveCaloriesBurned",
            "BasalMetabolicRate",
            "Distance",
            "HeartRate",
            "Steps",
            "TotalCaloriesBurned"
          ],
          "healthPermissionWrite": [
            "ActiveCaloriesBurned",
            "TotalCaloriesBurned"
          ]
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "./plugins/withTTSQueries",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ConquerStreakWidget",
              "label": "ConquerONE Streak & Today's Workout",
              "description": "Shows current streak and today's workout target.",
              "minWidth": "160dp",
              "minHeight": "100dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fa539543-bc51-4677-8251-2e9ff8c7a17d"
      }
    },
    "sdkVersion": "54.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fa539543-bc51-4677-8251-2e9ff8c7a17d"
    }
  }
}
